/**
 * Wrangler config for the Cloudflare Durable Object template
 * STRICTLY DO NOT MODIFY THIS FILE - Hidden from AI to prevent breaking core functionality
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "masjidhub-saas-jtbg-y-udxepva-ni4x4t",
	"main": "worker/index.ts",
	"compatibility_date": "2025-04-24",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "!/api/docs/*"]
	},
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "GlobalDurableObject",
				"class_name": "GlobalDurableObject"
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "masjidhub-bucket"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "masjidhub-db",
			"database_id": "5cea6147-9483-4e16-8f7a-9242f83580d8",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"GlobalDurableObject"
			]
		}
	]
}
