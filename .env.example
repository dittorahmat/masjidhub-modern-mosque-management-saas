# ==============================================================================
# MasjidHub Environment Variables Template
# Copy this file to .env and adjust the values according to your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Host Configuration (VPS / Local Node / Bun Standalone Server)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Path for local SQLite storage (used when running on VPS / standalone Node/Bun
# instead of Cloudflare D1).
SQLITE_DB_PATH=./data/sqlite.db
LOCAL_DB_PATH=./data/sqlite.db

# ------------------------------------------------------------------------------
# 3. File Storage Configuration
# ------------------------------------------------------------------------------
# Local directory for uploaded files and receipts (when not using Cloudflare R2).
# Served publicly via /uploads and /api/storage routes.
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# 4. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Google Gemini API key used for:
# - Bank statement OCR parsing and reconciliation (Gemini 2.5 Flash Lite)
# - Interactive AI Chatbot for mosque jamaah and visitors
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. Cloudinary Configuration (Optional Fallback / Image Optimization)
# ------------------------------------------------------------------------------
# Optional: Used for image optimization transformations and financial infographic generation
CLOUDINARY_CLOUD_NAME=masjidhub
CLOUDINARY_UPLOAD_PRESET=masjidhub_preset

# ------------------------------------------------------------------------------
# 6. Security & Internal Secret Key
# ------------------------------------------------------------------------------
# Internal secret key used for session salting and token generation
INTERNAL_SECRET_KEY=replace-with-a-secure-random-secret-key

# ------------------------------------------------------------------------------
# 7. Frontend & CORS Settings (Optional)
# ------------------------------------------------------------------------------
# Allowed origins for CORS if restricted (defaults to '*' in standalone server)
CORS_ORIGIN=*
